<Window x:Class="AiMergeTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="AI Merge Tool" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Padding="5">
            <Button Command="{Binding ResolveWithAiCommand}" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🤖" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Resolve with AI" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding SaveCommand}" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💾" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Save" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ExitCommand}" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖" FontSize="16" Margin="0,0,5,0"/>
                    <TextBlock Text="Exit" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- Three-pane editor view -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- OURS (Local) -->
            <Border Grid.Column="0" BorderBrush="#4A90E2" BorderThickness="2" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#4A90E2" Padding="8">
                        <TextBlock Text="OURS (Local)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </Border>
                    <avalonEdit:TextEditor 
                        Grid.Row="1"
                        x:Name="OursEditor"
                        FontFamily="Consolas"
                        FontSize="12"
                        ShowLineNumbers="True"
                        IsReadOnly="True"
                        Document="{Binding OursDocument}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- MERGED (Editable) -->
            <Border Grid.Column="2" BorderBrush="#50C878" BorderThickness="2" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#50C878" Padding="8">
                        <TextBlock Text="MERGED (Editable)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </Border>
                    <avalonEdit:TextEditor 
                        Grid.Row="1"
                        x:Name="MergedEditor"
                        FontFamily="Consolas"
                        FontSize="12"
                        ShowLineNumbers="True"
                        Document="{Binding MergedDocument}"/>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="#CCCCCC"/>

            <!-- THEIRS (Remote) -->
            <Border Grid.Column="4" BorderBrush="#E74C3C" BorderThickness="2" CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Background="#E74C3C" Padding="8">
                        <TextBlock Text="THEIRS (Remote)" FontWeight="Bold" Foreground="White" FontSize="14"/>
                    </Border>
                    <avalonEdit:TextEditor 
                        Grid.Row="1"
                        x:Name="TheirsEditor"
                        FontFamily="Consolas"
                        FontSize="12"
                        ShowLineNumbers="True"
                        IsReadOnly="True"
                        Document="{Binding TheirsDocument}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#F0F0F0" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="Processing..." Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ProgressBar Width="100" Height="20" IsIndeterminate="True"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
</Window>
