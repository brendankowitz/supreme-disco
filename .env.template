# AI Merge Tool - Environment Configuration Template
# Copy this file to .env and fill in your values
# DO NOT commit the .env file - it contains sensitive API keys!

# OpenAI Configuration
# Use this for direct OpenAI API access
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_IS_AZURE=false

# Azure OpenAI Configuration
# Use these settings for Azure OpenAI service
# OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# OPENAI_API_KEY=your-azure-api-key-here
# OPENAI_DEPLOYMENT=gpt-4
# OPENAI_IS_AZURE=true

# Advanced Settings (optional)
# OPENAI_MAX_TOKENS=4000
